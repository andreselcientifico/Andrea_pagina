  "query": "\n            SELECT \n                id::text, \n                lesson_id::text, \n                title, \n                description, \n                pass_percentage,\n                (SELECT COUNT(*) FROM questions WHERE quiz_id = q.id) as \"total_questions!\",\n                1 as \"order!\" -- Placeholder\n            FROM quizzes q\n            WHERE id = $1\n            ",
