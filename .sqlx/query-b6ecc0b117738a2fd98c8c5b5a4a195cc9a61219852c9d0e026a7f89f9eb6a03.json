  "query": "\n            INSERT INTO certificates (id, user_id, course_id, certificate_number, completion_percentage, issue_date)\n            VALUES ($1, $2, $3, $4, $5, $6)\n            ON CONFLICT (user_id, course_id) DO UPDATE \n                SET completion_percentage = $5\n            RETURNING *\n            ",
