{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                c.id, \n                c.course_id, \n                c.user_id, \n                u.name as user_name, \n                co.title as course_title, \n                c.issue_date, \n                c.completion_percentage, \n                c.certificate_number\n            FROM certificates c\n            JOIN users u ON c.user_id = u.id\n            JOIN courses co ON c.course_id = co.id\n            WHERE c.user_id = $1\n            ORDER BY c.issue_date DESC\n            ",
